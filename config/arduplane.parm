# Native ArduPlane plane FDM, ordinary wheels/ground roll, 2 kg and 0.45 m2.
# Arming checks and EKF are intentionally retained.
SYSID_THISMAV 2
ARMING_CHECK 1
ARMING_RUDDER 0
FLTMODE1 0
RC1_MIN 1000
RC1_MAX 2000
RC1_TRIM 1500
RC2_MIN 1000
RC2_MAX 2000
RC2_TRIM 1500
RC3_MIN 1000
RC3_MAX 2000
RC3_TRIM 1000
RC4_MIN 1000
RC4_MAX 2000
RC4_TRIM 1500
SERVO1_FUNCTION 4
SERVO2_FUNCTION 19
SERVO3_FUNCTION 70
SERVO4_FUNCTION 21
SERVO1_MIN 1000
SERVO1_MAX 2000
SERVO1_TRIM 1500
SERVO2_MIN 1000
SERVO2_MAX 2000
SERVO2_TRIM 1500
SERVO3_MIN 1000
SERVO3_MAX 2000
SERVO3_TRIM 1000
SERVO4_MIN 1000
SERVO4_MAX 2000
SERVO4_TRIM 1500
SERVO2_REVERSED 0
SERVO4_REVERSED 0
ARSPD_TYPE 100
ARSPD_USE 1
AIRSPEED_CRUISE 18
AIRSPEED_MIN 12
AIRSPEED_MAX 25
SCALING_SPEED 15
ROLL_LIMIT_DEG 40
PTCH_LIM_MAX_DEG 20
PTCH_LIM_MIN_DEG -15
WP_RADIUS 20
WP_LOITER_RAD 60
TKOFF_THR_MINACC 0
TKOFF_THR_MINSPD 0
TKOFF_THR_DELAY 0
TKOFF_ROTATE_SPD 12
TKOFF_THR_MAX 100
LAND_FLARE_ALT 4
LAND_FLARE_SEC 3
LAND_PITCH_DEG 6
LAND_DISARMDELAY 5
TECS_LAND_ARSPD 15
TECS_LAND_SINK 0.5
THR_MIN 0
THR_MAX 100
FS_LONG_ACTN 0
FS_SHORT_ACTN 0
FS_GCS_ENABL 0
SIM_WIND_SPD 2
SIM_WIND_DIR 270
SIM_WIND_TURB 0.1
LOG_DISARMED 1
# Standard ideal SITL sensor calibration (same convention as upstream plane-jsbsim).
INS_ACCOFFS_X 0.001
INS_ACCOFFS_Y 0.001
INS_ACCOFFS_Z 0.001
INS_ACCSCAL_X 1.001
INS_ACCSCAL_Y 1.001
INS_ACCSCAL_Z 1.001
INS_ACC2OFFS_X 0.001
INS_ACC2OFFS_Y 0.001
INS_ACC2OFFS_Z 0.001
INS_ACC2SCAL_X 1.001
INS_ACC2SCAL_Y 1.001
INS_ACC2SCAL_Z 1.001
RLL2SRV_RMAX 60
RLL2SRV_TCONST 0.4
RLL_RATE_D 0.017430
RLL_RATE_FF 0.237212
RLL_RATE_I 0.25
RLL_RATE_P 0.3
# Tuned against native plane FDM: old pitch FF caused a sustained limit cycle.
# Preserve wind/turbulence, normal arming and the 400 Hz FDM.
PTCH2SRV_RMAX_DN 35
PTCH2SRV_RMAX_UP 35
PTCH2SRV_TCONST 0.6
PTCH_RATE_D 0.001
PTCH_RATE_FF 0.15
PTCH_RATE_I 0.10
PTCH_RATE_P 0.04
PTCH2SRV_RLL 1
NAVL1_PERIOD 15

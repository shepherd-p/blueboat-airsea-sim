<?xml version='1.0' encoding='utf-8'?>
<sdf version="1.6">
  <model name="water_surface">
    <static>true</static>
    <link name="link">
      <visual name="visual">
        <geometry>
          <mesh>
            <uri>meshes/mesh.dae</uri>
          </mesh>
        </geometry>
        <plugin filename="gz-sim-shader-param-system" name="gz::sim::systems::ShaderParam">
          <shader language="glsl">
            <vertex>materials/programs/GerstnerWaves_vs_330.glsl</vertex>
            <fragment>materials/programs/GerstnerWaves_fs_330.glsl</fragment>
          </shader>
          <param>
            <shader>vertex</shader>
            <name>Nwaves</name>
            <type>int</type>
            <value>3</value>
          </param>
          <param>
            <shader>vertex</shader>
            <name>rescale</name>
            <type>float</type>
            <value>0.5</value>
          </param>
          <param>
            <shader>vertex</shader>
            <name>bumpScale</name>
            <type>float_array</type>
            <value>50 50</value>
          </param>
          <param>
            <shader>vertex</shader>
            <name>bumpSpeed</name>
            <type>float_array</type>
            <value>0.012 0.007</value>
          </param>
          <param>
            <shader>vertex</shader>
            <name>amplitude</name>
            <type>float_array</type>
            <value>0 0 0</value>
          </param>
          <param>
            <shader>vertex</shader>
            <name>wavenumber</name>
            <type>float_array</type>
            <value>0.028 0.0896 0.0504</value>
          </param>
          <param>
            <shader>vertex</shader>
            <name>omega</name>
            <type>float_array</type>
            <value>0.5 1.7 1.0</value>
          </param>
          <param>
            <shader>vertex</shader>
            <name>dir0</name>
            <type>float_array</type>
            <value>-1.0 0.0</value>
          </param>
          <param>
            <shader>vertex</shader>
            <name>dir1</name>
            <type>float_array</type>
            <value>-0.7 0.7</value>
          </param>
          <param>
            <shader>vertex</shader>
            <name>dir2</name>
            <type>float_array</type>
            <value>0.7 0.7</value>
          </param>
          <param>
            <shader>vertex</shader>
            <name>steepness</name>
            <type>float_array</type>
            <value>1.0 1.5 0.8</value>
          </param>
          <param>
            <shader>vertex</shader>
            <name>tau</name>
            <type>float</type>
            <value>2.0</value>
          </param>
          <param>
            <shader>vertex</shader>
            <name>camera_position_object_space</name>
          </param>
          <param>
            <shader>vertex</shader>
            <name>worldviewproj_matrix</name>
          </param>
          <param>
            <shader>vertex</shader>
            <name>t</name>
            <value>TIME</value>
          </param>
          <param>
            <shader>fragment</shader>
            <name>hdrMultiplier</name>
            <type>float</type>
            <value>0.7</value>
          </param>
          <param>
            <shader>fragment</shader>
            <name>fresnelPower</name>
            <type>float</type>
            <value>5.0</value>
          </param>
          <param>
            <shader>fragment</shader>
            <name>shallowColor</name>
            <type>float_array</type>
            <value>0.04 0.38 0.50 1</value>
          </param>
          <param>
            <shader>fragment</shader>
            <name>deepColor</name>
            <type>float_array</type>
            <value>0.0 0.13 0.22 1</value>
          </param>
          <param>
            <shader>fragment</shader>
            <name>cubeMap</name>
            <type>texture_cube</type>
            <value>materials/textures/skybox_lowres.dds</value>
            <arg>1</arg>
          </param>
          <param>
            <shader>fragment</shader>
            <name>bumpMap</name>
            <type>texture</type>
            <value>materials/textures/wave_normals.dds</value>
          </param>
        </plugin>
      </visual>
    </link>
    <pose>0 0 -0.005 0 0 0</pose>
  </model>
</sdf>